{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/",
      "dest": "/api/webhook.py"
    }
  ],
  "env": {
    "BOT_TOKEN": "@bot_token",
    "OWNER_ID": "@owner_id",
    "SUPPORT_USERNAME": "@support_username"
  },
  "functions": {
    "api/webhook.py": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
